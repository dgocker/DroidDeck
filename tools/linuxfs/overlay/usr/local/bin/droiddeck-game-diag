#!/usr/bin/python3
"""Game diagnostics for one launch: what started, and how it ended.

droiddeck-game-env (Proton) and droiddeck-fex (Linux games) used to exec the game, so its exit went
to the Steam client's reaper and nowhere else: a game that crashed and one that was quit looked the
same from the app. With the app's diagnostics directory in BL_DIAG_DIR, a real game launch
(waitforexitandrun) runs through run() instead:

  - the launch command is started as a child and waited on, never exec'd. Signals the launcher
    gets from outside (the client's Stop, the session closing) are passed on to it, and the status
    the client sees is the game's own (128 + N for a signal, as a shell reports it);
  - <id>.start.json and <id>.exit.json are written beside each other in BL_DIAG_DIR, each through a
    rename, so the app never reads half a record. The exit record has the raw wait status: exit
    code, signal, core dump flag, the signals that were passed on, and whether the start failed;
  - the game's stderr (Proton, Wine, DXVK/VKD3D-Proton, FEX, Mesa all write there) is copied to
    <id>.out.log up to BL_DIAG_OUTPUT_CAP bytes while still going where it went before (the session
    log). The copy is made by a thread of this process, in 64 KiB reads; the game itself never
    writes to a file for it.

Nothing here may keep a game from starting: a record that cannot be written is skipped, and with
DROIDDECK_DIAGNOSTICS=0 (or no BL_DIAG_DIR) the callers exec exactly as before.
"""
import fcntl
import json
import os
import re
import secrets
import signal
import struct
import subprocess
import sys
import threading
import time
from pathlib import Path

SCHEMA = 1
DEFAULT_OUTPUT_CAP = 32 * 1024 * 1024
MAX_OUTPUT_CAP = 1024 * 1024 * 1024
# Linux's F_SETPIPE_SZ: a 1 MiB pipe lets a burst of Wine's messages through while this process
# is not scheduled, rather than making the game's write() wait for it.
F_SETPIPE_SZ = 1031
PIPE_SIZE = 1024 * 1024
FORWARDED = ("SIGTERM", "SIGINT", "SIGHUP", "SIGQUIT", "SIGUSR1", "SIGUSR2")
OFF = ("0", "off", "false", "no")
MAX_ARGS = 64
MAX_ARG_LENGTH = 256

# A launch argument or environment value that carries a credential: Epic's -AUTH_PASSWORD=<code>,
# -epicovt=<token>, a --password <value> pair, anything named like a token, key or session.
SECRET_NAME = re.compile(
    r"(?i)(password|passwd|pwd|token|secret|auth|ticket|apikey|api_key|private[_-]?key|session|cookie|"
    r"credential|epicovt|exchange[_-]?code|otp)")
URL_QUERY = re.compile(r"([A-Za-z][A-Za-z0-9+.\-]*://[^\s?#]*)[?#]\S*")


def enabled(env):
    """The directory to record into, or None: diagnostics are off or it is not writable."""
    if env.get("DROIDDECK_DIAGNOSTICS", "1").strip().lower() in OFF:
        return None
    directory = env.get("BL_DIAG_DIR")
    if not directory or not os.path.isdir(directory) or not os.access(directory, os.W_OK):
        return None
    return directory


def output_cap(env):
    try:
        cap = int(env.get("BL_DIAG_OUTPUT_CAP", DEFAULT_OUTPUT_CAP))
    except (TypeError, ValueError):
        return DEFAULT_OUTPUT_CAP
    return max(0, min(cap, MAX_OUTPUT_CAP))


def sample_interval(env):
    """Seconds between samples of FEX's counters and the CPU (BL_DIAG_SAMPLE_INTERVAL); 0 turns them off."""
    try:
        value = float(env.get("BL_DIAG_SAMPLE_INTERVAL", SAMPLE_INTERVAL))
    except (TypeError, ValueError):
        return SAMPLE_INTERVAL
    return 0.0 if value <= 0 else max(1.0, min(value, 600.0))


def new_launch_id(now=None):
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime(now))
    return "%s-%d-%s" % (stamp, os.getpid(), secrets.token_hex(3))


def boot_ns():
    """CLOCK_BOOTTIME: the clock Android's SystemClock.elapsedRealtimeNanos() reads, so the app can
    line the guest's times up with its own; it keeps counting through deep sleep."""
    try:
        return time.clock_gettime_ns(time.CLOCK_BOOTTIME)
    except (AttributeError, OSError):
        return time.monotonic_ns()


def read_first_line(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.readline().strip() or None
    except OSError:
        return None


def boot_id():
    return read_first_line("/proc/sys/kernel/random/boot_id")


def start_time(pid):
    """/proc/<pid>/stat's start time in clock ticks: with the pid it names the process, not the number."""
    try:
        with open("/proc/%d/stat" % pid, encoding="utf-8", errors="replace") as f:
            stat = f.read()
        return int(stat.rsplit(") ", 1)[1].split()[19])
    except (OSError, IndexError, ValueError):
        return None


def file_size(path):
    try:
        return os.stat(path).st_size if path else None
    except OSError:
        return None


def iso(unix):
    return time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(unix)) + ".%03dZ" % int((unix % 1) * 1000)


def redact_args(args):
    """Launch arguments as a report may show them: a credential's value blanked, wherever it is -
    `-AUTH_PASSWORD=x`, `--token x`, a URL's query - and long or many arguments cut short."""
    out = []
    blank_next = False
    for arg in list(args)[:MAX_ARGS]:
        arg = str(arg)
        if blank_next:
            out.append("<redacted>")
            blank_next = False
            continue
        if "://" in arg:
            arg = URL_QUERY.sub(r"\1?<redacted>", arg)
        elif "=" in arg and SECRET_NAME.search(arg.split("=", 1)[0]):
            out.append(arg.split("=", 1)[0] + "=<redacted>")
            continue
        if arg.startswith("-") and SECRET_NAME.search(arg):
            out.append(arg)
            blank_next = True
            continue
        out.append(arg if len(arg) <= MAX_ARG_LENGTH else arg[:MAX_ARG_LENGTH] + "...")
    if len(args) > MAX_ARGS:
        out.append("... %d more" % (len(args) - MAX_ARGS))
    return out


def exe_label(path):
    """The game's executable without the user's own folders: from the library's common/ down when it
    is in one, else its name only."""
    if not path:
        return None
    text = str(path).replace("\\", "/")
    marker = "/steamapps/common/"
    if marker in text:
        return text.split(marker, 1)[1]
    return text.rsplit("/", 1)[-1]


NAME = re.compile(r'^\s*"name"\s+"((?:[^"\\]|\\.)*)"', re.MULTILINE)
LIBRARY_PATH = re.compile(r'^\s*"path"\s+"((?:[^"\\]|\\.)*)"', re.MULTILINE)


def manifest_name(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            m = NAME.search(f.read(65536))
        return m.group(1).replace('\\"', '"') if m else None
    except OSError:
        return None


def game_name(app_id, env, exe=None):
    """(name, where it came from): the library's appmanifest, else the executable's name."""
    if app_id:
        candidates = []
        install = env.get("STEAM_COMPAT_INSTALL_PATH")
        if install:
            candidates.append(Path(install).parent.parent)
        root = Path(env.get("STEAM_COMPAT_CLIENT_INSTALL_PATH") or Path(env.get("HOME") or "/root") / ".local/share/Steam")
        candidates.append(root / "steamapps")
        try:
            text = (root / "steamapps/libraryfolders.vdf").read_text(encoding="utf-8", errors="replace")
            candidates += [Path(p.replace("\\\\", "\\")) / "steamapps" for p in LIBRARY_PATH.findall(text)]
        except OSError:
            pass
        candidates += [Path("/mnt/droiddeck/steamapps"), Path("/mnt/droiddeck-sd/steamapps")]
        seen = set()
        for steamapps in candidates:
            if steamapps in seen:
                continue
            seen.add(steamapps)
            name = manifest_name(steamapps / ("appmanifest_%s.acf" % app_id))
            if name:
                return name, "appmanifest"
    if exe:
        stem = str(exe).replace("\\", "/").rsplit("/", 1)[-1]
        stem = re.sub(r"(?i)\.(exe|sh|x86_64|x86|bin)$", "", stem)
        if stem:
            return stem, "executable"
    return None, "unknown"


def write_record(path, record):
    """[record] as [path], through a rename, synced: a record is whole or absent, also after a crash."""
    tmp = path + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(record, f, indent=1, sort_keys=True)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
        return True
    except (OSError, TypeError, ValueError) as error:
        print("droiddeck-game-diag: %s not written (%s)" % (os.path.basename(path), error), file=sys.stderr)
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


class Tee:
    """The child's stderr through a pipe: every byte on to where stderr went before, and the first
    [cap] bytes into [path]. A failure on either side stops only that side."""

    def __init__(self, path, cap, passthrough=2):
        self.path = path
        self.cap = cap
        self.passthrough = passthrough
        self.seen = 0
        self.kept = 0
        self.errors = []
        self.capped = False
        self.read_fd, self.write_fd = os.pipe()
        try:
            fcntl.fcntl(self.write_fd, F_SETPIPE_SZ, PIPE_SIZE)
        except OSError:
            pass
        try:
            self.out = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_CLOEXEC, 0o600)
        except OSError as error:
            self.out = None
            self.errors.append("output file: %s" % error)
        self.thread = threading.Thread(target=self.pump, name="diag-tee", daemon=True)

    def start(self):
        self.thread.start()

    def child_started(self):
        """The child holds its own copy of the write end now; ours closes so the pipe ends with it."""
        try:
            os.close(self.write_fd)
        except OSError:
            pass

    def pump(self):
        while True:
            try:
                data = os.read(self.read_fd, 65536)
            except OSError as error:
                self.errors.append("read: %s" % error)
                break
            if not data:
                break
            self.seen += len(data)
            if self.passthrough is not None:
                try:
                    view = memoryview(data)
                    while view:
                        view = view[os.write(self.passthrough, view):]
                except OSError as error:
                    self.errors.append("passthrough: %s" % error)
                    self.passthrough = None
            if self.out is not None:
                room = self.cap - self.kept
                chunk = data[:room] if room < len(data) else data
                try:
                    if chunk:
                        os.write(self.out, chunk)
                        self.kept += len(chunk)
                    if len(chunk) < len(data):
                        self.capped = True
                        os.write(self.out, b"\n[droiddeck-game-diag: output capped at %d bytes; the rest went to the session log only]\n" % self.cap)
                        self.close_out()
                except OSError as error:
                    self.errors.append("write: %s" % error)
                    self.close_out()
        try:
            os.close(self.read_fd)
        except OSError:
            pass

    def close_out(self):
        if self.out is not None:
            try:
                os.close(self.out)
            except OSError:
                pass
            self.out = None

    def finish(self, timeout):
        """Waits up to [timeout] s for the pipe to end; a process the game left behind may hold it."""
        self.thread.join(timeout)
        complete = not self.thread.is_alive()
        if complete:
            self.close_out()
        return {"file": os.path.basename(self.path), "bytes_seen": self.seen, "bytes_kept": self.kept,
                "cap": self.cap, "capped": self.capped, "complete": complete, "errors": self.errors[:8]}


# FEX's live statistics (FEXCore/include/FEXCore/Utils/SHMStats.h, STATS_VERSION 2): a 64-byte header,
# then a singly linked list of per-thread records by offset. Proton's FEX writes them when ProfileStats
# is on, which the Config.json Proton ships turns on, to /dev/shm/fex-<pid>-stats.
FEX_STATS_HEADER = struct.Struct("<BBH48sIII")
FEX_THREAD = struct.Struct("<II13Q")
FEX_COUNTERS = ("jit_ticks", "signal_ticks", "sigbus", "smc", "float_fallbacks", "cache_misses",
                "cache_read_lock_ticks", "cache_write_lock_ticks", "jit_blocks", "disk_cache_hits",
                "disk_cache_misses", "disk_cache_lookup_ticks")
FEX_APP_TYPES = {0: "linux32", 1: "linux64", 2: "arm64ec", 3: "wow64"}
SAMPLE_INTERVAL = 10.0
SAMPLE_BYTES = 4 * 1024 * 1024


def read_fex_stats(data):
    """(header dict, {tid: counters}) from a stats file's bytes, or None when it is not one this reads."""
    if len(data) < FEX_STATS_HEADER.size:
        return None
    version, app_type, thread_size, fex_version, head, size, _ = FEX_STATS_HEADER.unpack_from(data, 0)
    if version != 2 or thread_size < FEX_THREAD.size:
        return None
    threads = {}
    offset, seen = head, 0
    while offset and offset + FEX_THREAD.size <= len(data) and seen <= len(data) // thread_size:
        fields = FEX_THREAD.unpack_from(data, offset)
        nxt, tid, counters = fields[0], fields[1], fields[2:2 + len(FEX_COUNTERS)]
        if tid:
            threads[tid] = counters
        offset, seen = nxt, seen + 1
    return {"version": fex_version.split(b"\0", 1)[0].decode("utf-8", "replace"),
            "app_type": FEX_APP_TYPES.get(app_type, str(app_type))}, threads


def parent_pid(pid):
    try:
        with open("/proc/%d/stat" % pid, encoding="utf-8", errors="replace") as f:
            return int(f.read().rsplit(") ", 1)[1].split()[1])
    except (OSError, IndexError, ValueError):
        return None


def in_tree(pid, root, cache):
    """Whether [pid] descends from [root]; [cache] remembers answers within one sample."""
    chain = []
    while pid and pid > 1 and pid not in cache:
        if pid == root:
            cache[pid] = True
            break
        chain.append(pid)
        pid = parent_pid(pid)
    answer = cache.get(pid, False) if pid and pid > 1 else False
    for p in chain:
        cache[p] = answer
    return answer


def cpu_ids(sys_root="/sys"):
    """Each distinct MIDR_EL1 the kernel shows here, or why one could not be read: Wine hands it to FEX,
    which recognises the CPU by it (Oryon's RNDRRS erratum, the LDAPUR errata of Cortex cores)."""
    base = os.path.join(sys_root, "devices/system/cpu")
    values, error = set(), None
    try:
        names = sorted(n for n in os.listdir(base) if re.fullmatch(r"cpu\d+", n))
    except OSError as e:
        return {"midr_el1": [], "error": "%s: %s" % (base, e.strerror or e)}
    for name in names:
        try:
            with open(os.path.join(base, name, "regs/identification/midr_el1"), encoding="utf-8") as f:
                values.add(f.read().strip())
        except OSError as e:
            error = error or "%s: %s" % (name, e.strerror or e)
    return {"midr_el1": sorted(values), "error": error}


PR_SET_CHILD_SUBREAPER = 36


def become_subreaper():
    """Makes this process the one orphaned descendants are handed to. Wine starts every Windows
    process with a double fork (dlls/ntdll/unix/process.c, spawn_process): without this the game's own
    process (java.exe, the game's .exe) leaves the launcher's tree for Steam's reaper, and nothing
    here can tell it belongs to the launch. True when the kernel took it."""
    try:
        import ctypes
        libc = ctypes.CDLL(None, use_errno=True)
        return libc.prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) == 0
    except (OSError, AttributeError):
        return False


def wait_for(child_pid, wait=os.waitpid):
    """The wait status of [child_pid]; the descendants handed to this process as their subreaper are
    reaped on the way, so none is left a zombie. None when there is nothing to wait for."""
    while True:
        try:
            pid, status = wait(-1, 0)
        except ChildProcessError:
            return None
        except InterruptedError:
            continue
        if pid == child_pid:
            return status


def read_text(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read().strip()
    except (OSError, UnicodeDecodeError):
        return None


def cpu_policies(sys_root="/sys"):
    """The cpufreq policies (clusters) by number: policyN -> its directory."""
    base = os.path.join(sys_root, "devices/system/cpu/cpufreq")
    try:
        names = [n for n in os.listdir(base) if re.fullmatch(r"policy\d+", n)]
    except OSError:
        return {}
    return {n: os.path.join(base, n) for n in sorted(names, key=lambda n: int(n[6:]))}


def zone_group(kind):
    """cpu or gpu for a thermal zone's type, None for any other zone (board, battery, modem...)."""
    kind = kind.lower()
    return "gpu" if "gpu" in kind else "cpu" if "cpu" in kind else None


def host_cpu(sys_root="/sys"):
    """What limits the CPU when the launch starts: each cluster's cores, hardware and current clock
    limits and governor, and every thermal zone by type - a zone that reads the same 110 C whether the
    phone is idle or not is then seen for what it is."""
    policies = {}
    for name, d in cpu_policies(sys_root).items():
        policies[name] = {
            "cpus": read_text(os.path.join(d, "related_cpus")) or read_text(os.path.join(d, "affected_cpus")),
            "cpuinfo_max_khz": read_int(os.path.join(d, "cpuinfo_max_freq")),
            "cpuinfo_min_khz": read_int(os.path.join(d, "cpuinfo_min_freq")),
            "scaling_max_khz": read_int(os.path.join(d, "scaling_max_freq")),
            "scaling_min_khz": read_int(os.path.join(d, "scaling_min_freq")),
            "governor": read_text(os.path.join(d, "scaling_governor")),
        }
    zones = []
    thermal = os.path.join(sys_root, "class/thermal")
    try:
        names = sorted((n for n in os.listdir(thermal) if n.startswith("thermal_zone")), key=lambda n: int(n[12:] or 0))
    except (OSError, ValueError):
        names = []
    for z in names:
        temp = read_int(os.path.join(thermal, z, "temp"))
        if temp is not None:
            zones.append([read_text(os.path.join(thermal, z, "type")) or z, temp])
    return {"policies": policies, "thermal_zones": zones}


def read_int(path):
    try:
        with open(path, encoding="utf-8") as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


class Sampler:
    """Every [interval] s, on a thread of its own: FEX's counters for each FEX process of the game (its
    stats file, summed over threads; a thread that exits keeps what it had counted when last seen), and
    the CPU clocks and the hottest thermal zone, where the kernel lets them be read. Rows go to
    <id>.fex.csv and <id>.cpu.csv, up to [limit] bytes each. Nothing here touches the game's threads."""

    def __init__(self, base, root_pid, interval=SAMPLE_INTERVAL, limit=SAMPLE_BYTES, shm="/dev/shm", sys_root="/sys"):
        self.base, self.root, self.interval, self.limit, self.shm, self.sys = base, root_pid, interval, limit, shm, sys_root
        self.started = time.monotonic()
        self.seen = {}      # (pid, tid) -> last counters
        self.totals = {}    # pid -> summed counters
        self.files = {}
        self.written = {}
        self.stop = threading.Event()
        self.thread = threading.Thread(target=self.loop, name="diag-sampler", daemon=True)
        self.cpus = sorted(int(n[3:]) for n in self.listdir(os.path.join(sys_root, "devices/system/cpu")) if re.fullmatch(r"cpu\d+", n))
        self.policies = cpu_policies(sys_root)

    @staticmethod
    def listdir(path):
        try:
            return os.listdir(path)
        except OSError:
            return []

    def start(self):
        self.thread.start()

    def finish(self, timeout=2.0):
        self.stop.set()
        if self.thread.is_alive():
            self.thread.join(timeout)
        for f in self.files.values():
            try:
                f.close()
            except OSError:
                pass
        return dict({name: self.written.get(name, 0) for name in ("fex", "cpu")}, interval_s=self.interval)

    def loop(self):
        while not self.stop.wait(self.interval):
            self.sample()
        self.sample()

    def write(self, name, header, row):
        f = self.files.get(name)
        if f is None:
            try:
                f = self.files[name] = open("%s.%s.csv" % (self.base, name), "w", encoding="utf-8")
                f.write(header + "\n")
            except OSError:
                self.files[name] = f = None
                return
        if f is None or self.written.get(name, 0) >= self.limit:
            return
        line = row + "\n"
        try:
            f.write(line)
            f.flush()
            self.written[name] = self.written.get(name, 0) + len(line)
        except OSError:
            pass

    def sample(self):
        t = "%.1f" % (time.monotonic() - self.started)
        cache = {}
        for name in sorted(self.listdir(self.shm)):
            m = re.fullmatch(r"fex-(\d+)-stats", name)
            if not m or not in_tree(int(m.group(1)), self.root, cache):
                continue
            pid = int(m.group(1))
            try:
                with open(os.path.join(self.shm, name), "rb") as f:
                    parsed = read_fex_stats(f.read(1024 * 1024))
            except OSError:
                continue
            if parsed is None:
                continue
            header, threads = parsed
            total = self.totals.setdefault(pid, [0] * len(FEX_COUNTERS))
            for tid, counters in threads.items():
                last = self.seen.get((pid, tid), (0,) * len(FEX_COUNTERS))
                for i, (now, before) in enumerate(zip(counters, last)):
                    total[i] += now - before if now >= before else now  # a reused slot starts again from 0
                self.seen[(pid, tid)] = counters
            self.write("fex", "t_s,pid,app_type,fex_version,threads," + ",".join(FEX_COUNTERS),
                       ",".join([t, str(pid), header["app_type"], header["version"], str(len(threads))] + [str(v) for v in total]))
        freqs = [read_int(os.path.join(self.sys, "devices/system/cpu/cpu%d/cpufreq/scaling_cur_freq" % c)) for c in self.cpus]
        # Each cluster's clock limit now: below its hardware maximum it is held down (thermal, a power mode).
        limits = [read_int(os.path.join(d, "scaling_max_freq")) for d in self.policies.values()]
        hottest, zone, group_max = None, "", {"cpu": None, "gpu": None}
        thermal = os.path.join(self.sys, "class/thermal")
        for z in sorted(self.listdir(thermal)):
            temp = read_int(os.path.join(thermal, z, "temp"))
            if temp is None:
                continue
            kind = read_text(os.path.join(thermal, z, "type")) or z
            group = zone_group(kind)
            if group and (group_max[group] is None or temp > group_max[group]):
                group_max[group] = temp
            if hottest is None or temp > hottest:
                hottest, zone = temp, kind.replace(",", " ")
        if any(v is not None for v in freqs + limits) or hottest is not None:
            self.write("cpu", "t_s," + ",".join("cpu%d_khz" % c for c in self.cpus)
                       + "".join(",%s_max_khz" % p for p in self.policies)
                       + ",cpu_temp_max_millic,gpu_temp_max_millic,thermal_max_millic,thermal_max_zone",
                       ",".join([t] + ["" if v is None else str(v) for v in freqs + limits]
                                + ["" if v is None else str(v) for v in (group_max["cpu"], group_max["gpu"], hottest)] + [zone]))


def decode_status(status):
    if os.WIFSIGNALED(status):
        sig = os.WTERMSIG(status)
        return {"exited": False, "exit_code": None, "signal": sig, "signal_name": signal_name(sig),
                "core_dumped": bool(os.WCOREDUMP(status))}
    if os.WIFEXITED(status):
        return {"exited": True, "exit_code": os.WEXITSTATUS(status), "signal": None, "signal_name": None,
                "core_dumped": False}
    return {"exited": False, "exit_code": None, "signal": None, "signal_name": None, "core_dumped": False}


def signal_name(number):
    try:
        return signal.Signals(number).name
    except ValueError:
        return "SIG%d" % number


def reported(decoded):
    """The status this launcher exits with: the child's code, or 128 + N for a signal."""
    if decoded["exited"]:
        return decoded["exit_code"]
    if decoded["signal"]:
        return 128 + decoded["signal"]
    return 1


def run(command, env, meta, directory, stock=None, on_stock=None, popen=subprocess.Popen, wait=os.waitpid,
        out_cap=None, tee_timeout=2.0):
    """Starts [command] with [env], waits for it and records the launch in [directory]. [stock] is the
    (command, env) to try when [command] cannot be started at all (a sync pack's launcher missing),
    [on_stock] is told when it is used. Returns the status to exit with."""
    launch_id = new_launch_id()
    base = os.path.join(directory, launch_id)
    cap = output_cap(env) if out_cap is None else out_cap
    tee = None
    output = None
    if cap > 0:
        try:
            tee = Tee(base + ".out.log", cap)
        except OSError as error:
            output = {"file": None, "errors": ["pipe: %s" % error]}

    pending = []
    child = None

    def forward(number, _frame):
        name = signal_name(number)
        pending.append(name)
        if child is not None:
            try:
                os.kill(child.pid, number)
            except OSError:
                pass

    previous = {}
    for name in FORWARDED:
        number = getattr(signal, name, None)
        if number is None:
            continue
        try:
            previous[number] = signal.signal(number, forward)
        except (OSError, ValueError):
            pass

    # A launcher started with SIGCHLD ignored would have its child reaped by the kernel and never see
    # its status. Waited on with the default here; the child still starts with it ignored, as an
    # exec'd launch would have left it.
    restore_chld = None
    try:
        if signal.getsignal(signal.SIGCHLD) == signal.SIG_IGN:
            previous[signal.SIGCHLD] = signal.signal(signal.SIGCHLD, signal.SIG_DFL)
            restore_chld = lambda: signal.signal(signal.SIGCHLD, signal.SIG_IGN)
    except (OSError, ValueError):
        pass

    subreaper = become_subreaper()
    started_unix = time.time()
    started_boot = boot_ns()
    errors = []
    used = None
    attempts = [(command, env, False)] + ([(stock[0], stock[1], True)] if stock else [])
    try:
        for argv, argv_env, is_stock in attempts:
            try:
                child = popen(argv, env=argv_env, close_fds=False, restore_signals=False,
                              stderr=tee.write_fd if tee else None, preexec_fn=restore_chld)
                used = (argv, is_stock)
                break
            except OSError as error:
                errors.append({"program": os.path.basename(argv[0]), "error": str(error), "errno": error.errno})
                if not is_stock and stock:
                    print("droiddeck-game-env: %s could not start (%s); stock launch" % (argv[0], error), file=sys.stderr)
                    if on_stock:
                        on_stock()
        if tee:
            tee.child_started()
            tee.start()
        sampler = None
        interval = sample_interval(env)
        if child is not None and interval > 0:
            try:
                # The launcher's own tree: with it a subreaper, every process of the game ends up in it.
                sampler = Sampler(base, os.getpid() if subreaper else child.pid, interval)
                sampler.start()
            except (OSError, RuntimeError):
                sampler = None
        for name in list(pending):
            number = getattr(signal, name, None)
            if child is not None and number is not None:
                try:
                    os.kill(child.pid, number)
                except OSError:
                    pass

        start = dict(meta)
        start.update({
            "schema": SCHEMA,
            "launch_id": launch_id,
            "started_utc": iso(started_unix),
            "started_unix_ms": int(started_unix * 1000),
            "started_boot_ns": started_boot,
            "boot_id": boot_id(),
            "wrapper_pid": os.getpid(),
            "wrapper_start_time": start_time(os.getpid()),
            "child_pid": child.pid if child is not None else None,
            "child_start_time": start_time(child.pid) if child is not None else None,
            "program": os.path.basename(used[0][0]) if used else os.path.basename(command[0]),
            "stock_fallback": bool(used and used[1]),
            "session_log_offset": file_size(env.get("BL_LOG")),
            "subreaper": subreaper,
            "cpu_ids": cpu_ids(),
            "host_cpu": host_cpu(),
            "output_file": os.path.basename(tee.path) if tee and tee.out is not None else None,
        })
        write_record(base + ".start.json", start)

        if child is None:
            decoded = {"exited": False, "exit_code": None, "signal": None, "signal_name": None, "core_dumped": False}
            status = None
            code = 127 if any(e.get("errno") == 2 for e in errors) else 126
        else:
            status = wait_for(child.pid, wait)
            decoded = decode_status(status) if status is not None else \
                {"exited": False, "exit_code": None, "signal": None, "signal_name": None, "core_dumped": False}
            child.returncode = -decoded["signal"] if decoded["signal"] else (decoded["exit_code"] if decoded["exited"] else 1)
            code = reported(decoded)
        ended_unix = time.time()
        ended_boot = boot_ns()
        if tee:
            output = tee.finish(tee_timeout)
        samples = sampler.finish() if sampler else None
        record = {
            "schema": SCHEMA,
            "launch_id": launch_id,
            "ended_utc": iso(ended_unix),
            "ended_unix_ms": int(ended_unix * 1000),
            "ended_boot_ns": ended_boot,
            "duration_ms": (ended_boot - started_boot) // 1000000,
            "raw_status": status,
            "launch_failed": child is None,
            "exec_errors": errors,
            "forwarded_signals": pending,
            "reported_status": code,
            "session_log_offset": file_size(env.get("BL_LOG")),
            "output": output,
            "samples": samples,
        }
        record.update(decoded)
        write_record(base + ".exit.json", record)
        return code
    finally:
        for number, handler in previous.items():
            try:
                signal.signal(number, handler)
            except (OSError, ValueError):
                pass
